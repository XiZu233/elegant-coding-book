# 教材配图生成脚本环境变量示例
# 复制为 .env 后填入真实值（.env 已加入 .gitignore，不会提交）

# GPT-Image-2 (OpenAI 官方)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# Nano Banana Pro (Google Gemini 3 Pro Image)
# 需通过支持 OpenAI 兼容格式的第三方端点调用，如 apiyi.com、laozhang.ai 等
NANO_BANANA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
NANO_BANANA_BASE_URL=https://api.apiyi.com/v1
